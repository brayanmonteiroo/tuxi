<?xml version="1.0" encoding="UTF-8"?>
<!--
  Config labwc da sessão TUXI (fonte: packaging/labwc).
  Tema SSD: packaging/themes/TUXI/labwc (nome "TUXI").
-->
<labwc_config>
  <core>
    <!-- Preferir decoração do compositor (identidade TUXI). -->
    <decoration>server</decoration>
    <gap>6</gap>
  </core>

  <!-- Limite tipo KDE: o labwc resiste nas bordas da área útil
       (ecrã menos exclusive-zone do tuxi-panel). NÃO usar <margin>
       em paralelo — soma com a exclusive-zone e “duplica” a reserva.
       Valor alto ≈ bloqueio duro (não esconder a janela atrás do painel). -->
  <resistance>
    <screenEdgeStrength>100000</screenEdgeStrength>
    <windowEdgeStrength>20</windowEdgeStrength>
  </resistance>

  <theme>
    <name>TUXI</name>
    <titlebar>
      <!-- ícone da app | título … | minimizar, maximizar, fechar -->
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>10</cornerRadius>
    <keepBorder>yes</keepBorder>
    <maximizedDecoration>titlebar</maximizedDecoration>
    <dropShadows>yes</dropShadows>
    <font place="ActiveWindow">
      <name>sans</name>
      <size>11</size>
      <weight>bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>sans</name>
      <size>11</size>
      <weight>normal</weight>
    </font>
    <font place="MenuItem">
      <name>sans</name>
      <size>11</size>
    </font>
    <font place="OnScreenDisplay">
      <name>sans</name>
      <size>12</size>
      <weight>bold</weight>
    </font>
  </theme>

  <keyboard>
    <default />
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="A-Escape">
      <action name="Exit" />
    </keybind>
    <!-- Super / menu iniciar: tratados pelo tuxi-panel (layer-shell). -->
  </keyboard>
  <mouse>
    <default />
  </mouse>

  <!-- Tamanho inicial = o que o app pede (default/hints). Sem Maximize
       forçado — se a app gravar “maximizado” ao fechar, ela própria
       restaura (como no KDE). Electron/Chromium: CSD próprio. -->
  <windowRules>
    <windowRule identifier="*" serverDecoration="yes" />
    <windowRule identifier="*chatgpt*" serverDecoration="no" />
    <windowRule identifier="chatgpt" serverDecoration="no" />
    <windowRule identifier="ChatGPT" serverDecoration="no" />
    <windowRule identifier="*Chromium*" serverDecoration="no" />
    <windowRule identifier="*chrom*" serverDecoration="no" />
    <windowRule identifier="*electron*" serverDecoration="no" />
    <windowRule identifier="*Bruno*" serverDecoration="no" />
    <windowRule identifier="bruno" serverDecoration="no" />
    <windowRule identifier="org.bruno*" serverDecoration="no" />
  </windowRules>
</labwc_config>
