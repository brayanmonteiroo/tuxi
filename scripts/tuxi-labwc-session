#!/usr/bin/env bash
# Sessão de desenvolvimento: labwc + painel TUXI.
#
# Instalação tipica (sudo): /usr/local/bin/tuxi-labwc-session
# Painel: $HOME/tuxi/target/debug/tuxi-panel
#
# LightDM precisa do TryExec em path mundial (/usr/local/bin), não em ~/.local —
# o usuário "lightdm" não lê /home/<user> (permissão 700).

set -euo pipefail

PANEL_CANDIDATES=(
  "${TUXI_PANEL:-}"
  "${HOME}/tuxi/target/debug/tuxi-panel"
  "${HOME}/.cargo/bin/tuxi-panel"
  "/usr/local/bin/tuxi-panel"
)

PANEL=""
for candidate in "${PANEL_CANDIDATES[@]}"; do
  if [[ -n "${candidate}" && -x "${candidate}" ]]; then
    PANEL="${candidate}"
    break
  fi
done

if [[ -z "${PANEL}" ]]; then
  echo "tuxi-panel não encontrado em ${HOME}/tuxi/target/debug/tuxi-panel" >&2
  echo "Compile com: cd ~/tuxi && cargo build -p tuxi-panel" >&2
  # Ainda sobe o labwc para não ficar em loop de login; sem painel.
  PANEL=""
fi

if ! command -v labwc >/dev/null 2>&1; then
  echo "labwc não encontrado. sudo dnf install labwc" >&2
  exit 1
fi

# Autostart mínimo: painel + terminal (para desenvolver dentro da sessão).
mkdir -p "${HOME}/.config/labwc"
AUTOSTART="${HOME}/.config/labwc/autostart"
if [[ ! -f "${AUTOSTART}" ]]; then
  cat > "${AUTOSTART}" <<'EOF'
#!/usr/bin/env bash
# Gerado pelo TUXI — edite à vontade.
EOF
  chmod +x "${AUTOSTART}"
fi

# Garante linhas do painel/terminal no autostart (idempotente).
ensure_line() {
  local line="$1"
  grep -Fqx "${line}" "${AUTOSTART}" 2>/dev/null || echo "${line}" >> "${AUTOSTART}"
}

if [[ -n "${PANEL}" ]]; then
  ensure_line "${PANEL} &"
fi

# Terminal se existir (desenvolvimento dentro do TUXI).
for term in xfce4-terminal foot kitty alacritty gnome-terminal; do
  if command -v "${term}" >/dev/null 2>&1; then
    ensure_line "${term} &"
    break
  fi
done

exec labwc
