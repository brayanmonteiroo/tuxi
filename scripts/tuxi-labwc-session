#!/usr/bin/env bash
# Sessão de desenvolvimento: labwc + painel TUXI.
#
# Para tela CHEIA (não janela "wlroots - X11"):
#   1) Logout até a tela de login, OU
#   2) Virt-Manager → Send Key → Ctrl+Alt+F3 → login no TTY
#   3) dbus-run-session -- ~/.local/bin/tuxi-labwc-session
#
# Se rodar de um terminal DENTRO do XFCE/Plasma, o labwc aninha em X11
# (janela preta) — igual testar no host. Use TUXI_ALLOW_NESTED=1 só se for proposital.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PANEL_CANDIDATES=(
  "${TUXI_PANEL:-}"
  "${HOME}/tuxi/target/debug/tuxi-panel"
  "${HOME}/.cargo/bin/tuxi-panel"
)

PANEL=""
for candidate in "${PANEL_CANDIDATES[@]}"; do
  if [[ -n "${candidate}" && -x "${candidate}" ]]; then
    PANEL="${candidate}"
    break
  fi
done

if [[ -z "${PANEL}" ]]; then
  echo "tuxi-panel não encontrado. Compile com: cargo build -p tuxi-panel" >&2
  exit 1
fi

if ! command -v labwc >/dev/null 2>&1; then
  echo "labwc não encontrado. Instale com: sudo dnf install labwc" >&2
  exit 1
fi

# Evita o “abriu uma janela” sem perceber.
if [[ -z "${TUXI_ALLOW_NESTED:-}" ]]; then
  if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
    echo "ERRO: já existe sessão gráfica (DISPLAY=${DISPLAY:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-})." >&2
    echo "O labwc vai abrir só como JANELA aninhada — não é o teste fullscreen." >&2
    echo >&2
    echo "Faça assim:" >&2
    echo "  1) Logout até a tela de login da VM" >&2
    echo "  2) No Virt-Manager: Send Key → Ctrl+Alt+F3" >&2
    echo "  3) Login no TTY como ${USER}" >&2
    echo "  4) dbus-run-session -- ${HOME}/.local/bin/tuxi-labwc-session" >&2
    echo >&2
    echo "Ou force aninhado (só debug): TUXI_ALLOW_NESTED=1 $0" >&2
    exit 1
  fi
fi

(
  sleep 0.4
  exec "${PANEL}"
) &

exec labwc
